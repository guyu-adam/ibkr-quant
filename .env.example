# quant v3 — environment configuration
# Copy this file to .env and fill in your credentials.
# .env is git-ignored and never committed.

# ── IBKR ────────────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT=1
PAPER_TRADE=true

# ── OKX ─────────────────────────────────────────────────────
OKX_FLAG=1
